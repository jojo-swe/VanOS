# ── Access / security (see SECURITY.md and ../docs/DEPLOYMENT.md) ─
# public | hybrid | private | edge
# Unset → public in next dev, hybrid in production
# Vercel: edge. VPS: private.
# VANOS_ACCESS_MODE=edge
# Exact `true` only. Opens the dashboard routes; it does not skip basic auth.
# Anything else leaves the dashboard 404. Ingest, MCP, and health stay as they are.
# VANOS_EDGE_DASHBOARD=true
# Public sample deployment only. Exact `true`. Leave unset on your VPS
# and on any host that holds real tokens. Skips dashboard sign-in, serves seed
# data, and refuses writes and ingest. See the root README, "Public demo".
# VANOS_DEMO_MODE=true
# Optional http(s) link on the demo banner. Leave unset so the demo
# does not point at a private repository.
# VANOS_DEMO_REPO_URL=

# UI basic auth (required in hybrid/private; also required on edge when set)
DASHBOARD_BASIC_USER=<dashboard-user>
DASHBOARD_BASIC_PASSWORD=<long-random-at-least-32-chars>

# VANOS_REQUIRE_BASIC_AUTH=true
# Private host: leave unset (default false). Do not mirror the public edge.
# VANOS_PUBLIC_INGEST=false
# VANOS_PUBLIC_INGEST_URL=https://<vercel-project>.vercel.app
# VANOS_PRIVATE_APP_URL=https://<vps-hostname>.<tailnet>.ts.net
# VANOS_ALLOWED_HOSTS=<vps-hostname>.<tailnet>.ts.net,<vercel-project>.vercel.app
# Required in private mode (Tailscale-User-Login fail-closed without this)
# VANOS_ALLOWED_TAILSCALE_USERS=<tailscale-login>
# VANOS_EDGE_SECRET=<long-random-edge-secret>
# VPS only. Never set this on the Vercel edge project.
# Forwarded headers count only when VANOS_TRUST_PROXY is also true.
# VANOS_TRUST_TAILSCALE_CGNAT=false
# Localhost behind a proxy that appends the client address. Not on Vercel.
# Rightmost untrusted X-Forwarded-For hop. Also required for Tailscale-User-Login.
# VANOS_TRUST_PROXY=true
# VANOS_RATE_LIMIT_PER_MIN=60

# Dashboard session. Required for the browser to stop asking for Basic auth.
# Stable across restarts (openssl rand -base64 32). The process does not generate one.
# At least 32 characters. Required at boot when TOTP is on.
# VANOS_SESSION_SECRET=<openssl rand -base64 32>
# Lifetime in days. Default 30. Clamped to 1…365. VANOS_SESSION_TTL_SECONDS is ignored.
# VANOS_SESSION_TTL_DAYS=30

# Optional dashboard TOTP (RFC 6238). Unset = basic auth, then the session cookie.
# Generate on the VPS with: npm run totp:setup
# Do not commit the secret, the recovery codes, or the hash file.
# VANOS_TOTP_SECRET=<base32-from-totp-setup>
# VANOS_TOTP_MAX_ATTEMPTS=5
# VANOS_TOTP_ATTEMPT_WINDOW_SEC=300
# VANOS_TOTP_ISSUER=VanOS
# VANOS_TOTP_ACCOUNT=<dashboard-user>
# VANOS_TOTP_RECOVERY_CODES=<sha256-hex>,<sha256-hex>
# VANOS_TOTP_RECOVERY_FILE=/etc/vanos/totp-recovery-hashes
# VANOS_TOTP_RECOVERY_USED_FILE=/etc/vanos/totp-recovery-hashes.used

# ── Tokens (different values, each at least 32 characters) ───────
# Startup refuses if these match or either is shorter than 32 characters.
# POST /api/bots/ingest only — not Agent API / MCP / HA / DF
BOTS_INGEST_SECRET=<long-random-ingest-secret>

# Agent API (/api/v1/*), stdio MCP, and POST /api/mcp
# Grok Bot connector header: Authorization: Bearer $AGENT_API_TOKEN
AGENT_API_TOKEN=<long-random-agent-token>
# Set the matching *_PREVIOUS to the old value while rotating, then remove it.
# AGENT_API_TOKEN_PREVIOUS=
# BOTS_INGEST_SECRET_PREVIOUS=
# VANOS_ALLOW_INGEST_AS_AGENT=true  # legacy only; avoid on public edges

# Base URL the MCP server calls (local or deployed Mission Control)
# VANOS_API_BASE=http://127.0.0.1:3000

# ── Grok Bot webhooks ────────────────────────────────────────────
GROK_BOT_DEFAULT_WEBHOOK_URL=https://api2.cursor.sh/…   # from routine → Webhook → POST to
GROK_BOT_DEFAULT_WEBHOOK_KEY=…                            # from routine → Webhook → key

# Optional per-Bot overrides (Muddy / Elon / Gary / Warren / Mission)
# GROK_BOT_MUDDY_WEBHOOK_URL=
# GROK_BOT_MUDDY_WEBHOOK_KEY=
# GROK_BOT_ELON_WEBHOOK_URL=
# GROK_BOT_ELON_WEBHOOK_KEY=
# GROK_BOT_GARY_WEBHOOK_URL=
# GROK_BOT_GARY_WEBHOOK_KEY=
# GROK_BOT_WARREN_WEBHOOK_URL=
# GROK_BOT_WARREN_WEBHOOK_KEY=
# GROK_BOT_MISSION_WEBHOOK_URL=
# GROK_BOT_MISSION_WEBHOOK_KEY=

# Optional JSON array override:
# GROK_BOT_WEBHOOKS_JSON=[{"id":"muddy","name":"Muddy","webhookUrl":"…","webhookKey":"…"}]

# ── Durable store ────────────────────────────────────────────────
# BOTS_DATA_DIR=/tmp/vanos-bots
# VANOS_DATA_DIR=/tmp/vanos-bots
# VANOS_STORE_PREFIX=vanos

# Upstash Redis REST (recommended on Vercel + multi-host)
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=…

# ── Money ────────────────────────────────────────────────────────
# Riksbanken's daily USD and EUR rates are fetched automatically (no key).
# off turns that off. Unset = on; always off in the demo.
# MONEY_FX_AUTO=off
# Pin kronor per dollar / per euro. A pin always wins over agent and Riksbank
# rates. Unset = the newer of an agent's rate and Riksbanken's, else 10.5 / 11.5.
# MONEY_USD_SEK_RATE=10.5
# MONEY_EUR_SEK_RATE=11.5

# ── Home Assistant (Tailscale URL + long-lived token) ────────────
# HOME_ASSISTANT_URL=http://homeassistant:8123
# HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_WATCH=light.kitchen,switch.sample,person.resident
# Services agents and the dashboard may call. Unset = lights, switches, fans,
# media players, input booleans and scene.turn_on. Locks/alarms stay blocked.
# HA_ALLOWED_SERVICES=light.*,switch.*,scene.turn_on

# ── DisplayFusion Windows bridge (Tailscale) ─────────────────────
# DISPLAYFUSION_BRIDGE_URL=http://desktop:17890/run
# DISPLAYFUSION_BRIDGE_SECRET=
# DISPLAYFUSION_SCRIPTS_JSON=[{"id":"coding","name":"Coding layout","command":"LoadWindowLayout"}]

# ── Integrations (each one stays off until its env is set) ──────
# Read-only. Do not log or commit the tokens. See INTEGRATIONS.md.
# Fine-grained PAT: Contents, Pull requests, Actions, and Metadata — Read only.
# GITHUB_TOKEN=
# GITHUB_OWNER=jojo-swe
# Internal integration secret. Share each database with the integration.
# NOTION_TOKEN=
# NOTION_DATABASE_IDS=
# Optional. Defaults are Status and Klart (Status ≠ Klart).
# NOTION_STATUS_PROPERTY=Status
# NOTION_DONE_VALUE=Klart
# Slack. Panel: bot token (xoxb-…) with channels:history, channels:read,
# groups:history, groups:read and optionally users:read; invite the bot to
# each channel. Notifications: an incoming webhook (hooks.slack.com only).
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_IDS=C0123ABCD,C0456EFGH
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# errors (default) | all (also finished results) | off
# SLACK_NOTIFY=errors
# Absolute path to the vault folder on this host (not / or /home).
# OBSIDIAN_VAULT_PATH=
# Optional Obsidian Local REST API plugin. Both are required together.
# OBSIDIAN_API_URL=http://127.0.0.1:27123
# OBSIDIAN_API_KEY=
# Exact true only, for the plugin's self-signed HTTPS cert on a trusted network.
# OBSIDIAN_API_INSECURE=false
